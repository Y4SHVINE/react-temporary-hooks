{
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test --passWithNoTests",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "react-temporary-hooks",
  "description": "A collection of React hooks for managing temporary DOM element changes with automatic reversion.",
  "author": "Yashvida Jayasekara",
  "module": "dist/react-temporary-hooks.esm.js",
  "size-limit": [
    {
      "path": "dist/react-temporary-hooks.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/react-temporary-hooks.esm.js",
      "limit": "10 KB"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Y4SHVINE/react-temporary-hooks"
  },
  "keywords": [
    "react",
    "react-hook",
    "hook",
    "temporary",
    "timed",
    "flash",
    "text content",
    "timed effects",
    "temporary state",
    "react utility",
    "ui utility",
    "frontend",
    "temporary hooks"
  ],
  "homepage": "https://y4shvine.github.io/react-temporary-hooks/",
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "husky": "^9.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.8.1",
    "typescript": "^3.9.10"
  }
}
